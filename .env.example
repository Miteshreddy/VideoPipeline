# DubFlow Environment Configuration

# Whisper model to use for transcription: tiny, base, small, medium, large-v3
WHISPER_MODEL=small

# Directory for storing workspace jobs and output media
OUTPUT_DIR=workspace

# Default English voice for speech synthesis (edge-tts voices)
# Options: en-US-AriaNeural, en-US-GuyNeural, en-US-JennyNeural, en-US-ChristopherNeural
DEFAULT_VOICE=en-US-AriaNeural

# Optional YouTube cookies file or browser name for authenticated/age-restricted downloads
# YOUTUBE_COOKIES_FILE=cookies.txt
# YOUTUBE_COOKIES_BROWSER=chrome

# Server configuration
HOST=127.0.0.1
PORT=8000
